# Copia este archivo como .env para cambiar los valores por defecto del entorno local.
# No pongas aquí secretos reales: este archivo se versiona. El archivo .env no se versiona.

# Base de datos
DB_NAME=tramites
DB_USER=tramites
DB_PASSWORD=cambia_esta_clave
DB_PORT=5433

# Puertos publicados en tu máquina
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Usuarios de demostración (uno por rol, dominio demo.pa). Solo para desarrollo local.
DEMO_USUARIOS=true
DEMO_CONTRASENA=Cambia-Esta-Clave-2026

# Correo simulado: el enlace de recuperación de contraseña se escribe en el registro del backend.
# Solo para desarrollo local; fuera de él debe quedar en false.
CORREO_SIMULADO=true
